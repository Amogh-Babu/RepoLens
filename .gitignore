# ==============================================================================
# 1. Environment Variables & Credentials (CRITICAL)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# ==============================================================================
# 2. Package Dependencies & Virtual Environments
# ==============================================================================
# Node / Frontend
node_modules/
jspm_packages/
.pnpm-store/

# Python
venv/
.venv/
env/
ENV/
__pypackages__/

# ==============================================================================
# 3. Build Outputs, Bundles & Compiled Code
# ==============================================================================
# JavaScript / TypeScript / Next.js
dist/
build/
out/
.next/
.turbo/
.parcel-cache/

# Python bytecode & wheels
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# C / C++ (if native modules or services exist)
*.o
*.obj
*.out
*.app

# ==============================================================================
# 4. Logs, Caches & Diagnostics
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage & tooling caches
.nyc_output/
coverage/
*.lcov
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.eslintcache

# ==============================================================================
# 5. OS & IDE Metadata
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ==============================================================================
# 6. Test Fixtures
# ==============================================================================
# The ingestion filter's fixture tree deliberately contains vendored and
# generated paths, so the rules above must not hide it from Git.
!backend/tests/fixtures/filter_mini_repo/node_modules/
!backend/tests/fixtures/filter_mini_repo/build/
!backend/tests/fixtures/filter_mini_repo/app.egg-info/
