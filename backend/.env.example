# Example backend configuration. The backend reads these from the process
# environment; it does not load this file itself. Export them in your shell,
# or copy the AI lines into a `.env` file at the repository root, which
# `docker compose` reads. Never commit a real key.

# Optional: SQLite file for the graph store (in memory when unset).
# REPOLENS_DB_PATH=/data/repolens.db

# Optional: raises GitHub's API limit of 60 requests an hour.
# GITHUB_TOKEN=

# --- AI file summaries (optional, off by default) ---------------------------
# Enabling sends the source of each file you summarize to OpenAI.
REPOLENS_AI_ENABLED=false
OPENAI_API_KEY=
REPOLENS_AI_MODEL=gpt-5.4-mini
REPOLENS_AI_TIMEOUT_SECONDS=30
REPOLENS_AI_MAX_INPUT_CHARS=40000
REPOLENS_AI_MAX_OUTPUT_TOKENS=4096
REPOLENS_AI_MAX_CONCURRENT_REQUESTS=2
REPOLENS_AI_DAILY_CALL_LIMIT=100
# New summaries per visitor (client IP) per hour; 0 turns this limit off.
REPOLENS_AI_CLIENT_HOURLY_LIMIT=10
# REPOLENS_AI_MAX_RETRIES=1
# REPOLENS_AI_REGENERATE_COOLDOWN_SECONDS=60
# REPOLENS_AI_REASONING_EFFORT=
# USD per million tokens, only for cost estimates in logs and /ai/status.
# REPOLENS_AI_INPUT_COST_PER_MILLION=
# REPOLENS_AI_OUTPUT_COST_PER_MILLION=
