# Copy to .env.local and adjust. .env.local is not committed.

# Which API client the app uses:
#   http - the real FastAPI backend (default)
#   mock - in-memory fixture data, no backend needed
VITE_API_MODE=http

# Base URL of the backend in http mode. The default "/api" goes through the
# dev server proxy below, which avoids CORS during development.
VITE_API_BASE_URL=/api

# Where the dev server proxy sends /api requests (prefix removed).
API_PROXY_TARGET=http://localhost:8000
